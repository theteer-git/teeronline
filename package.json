{
  "name": "teeronline",
  "version": "1.0.0",
  "description": "TeerOnline public site assets",
  "private": true,
  "scripts": {
    "build:pages": "node assets/scripts/build-pages-split.js",
    "validate:game-config": "node assets/scripts/validate-game-config.js",
    "build:unified-games": "node assets/scripts/build-unified-game-pages.js",
    "validate:unified-games": "node assets/scripts/validate-unified-game-pages.js",
    "validate:content-quality": "node assets/scripts/validate-content-quality.js",
    "validate:production-package": "node assets/scripts/validate-production-package.js",
    "gate:production": "npm run validate:game-config && npm run validate:unified-games && npm run validate:content-quality && npm run validate:jsonld && npm run validate:production-package",
    "validate:jsonld": "node assets/scripts/validate-jsonld.js"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "cheerio": "^1.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
